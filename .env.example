# Required
KEYCARD_ZONE_URL=https://<zone-id>.keycard.cloud
KEYCARD_CLIENT_ID=<client-id>
KEYCARD_CLIENT_SECRET=<client-secret>
SNOWFLAKE_ACCOUNT_URL=https://<account>.snowflakecomputing.com

# Optional — defaults used by tools when not overridden per-request
SNOWFLAKE_DATABASE=GREENDALE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Optional — server port (default: 3100)
PORT=3100
